{
  "name": "tiktools-admin",
  "private": true,
  "version": "0.1.0",
  "description": "TikTools Cloud admin dashboard (Vite + Vue 3 + TypeScript). Same-origin cookie sessions only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "pinia": "^2.2.6",
    "reka-ui": "^2.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
