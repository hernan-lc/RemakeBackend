{
  "name": "tiktools-admin",
  "private": true,
  "version": "0.1.0",
  "description": "TikTools Cloud admin dashboard (Vite + Vue 3 + TypeScript). Same-origin cookie sessions only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test --config playwright/playwright.config.ts",
    "demo": "vite --mode demo"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "pinia": "^2.2.6",
    "reka-ui": "^2.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.3"
    },
    "editorconfig": {
      "minimatch": "^11.0.4"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
