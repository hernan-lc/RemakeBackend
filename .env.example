BIND_ADDR=127.0.0.1:3000
DATABASE_URL=postgres://cloud:local-only-password@localhost:5432/cloud
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional JWKS refresh policy (seconds); defaults are shown.
# GOOGLE_JWKS_REFRESH_SECONDS=3600
# GOOGLE_JWKS_MAX_STALE_SECONDS=86400
# GOOGLE_JWKS_MIN_RETRY_SECONDS=60
# Optional quarantine storage: configure all five together; use a versioned bucket.
# STORAGE_ENDPOINT=https://s3.example.test
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=cloud-quarantine
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# Required by the one-shot verification worker; clamd must be on loopback.
# CLAMAV_ADDR=127.0.0.1:3310
# Initial snapshot candidate worker only; use independently provisioned private files.
# SNAPSHOT_SEED_DIR=/private/empty-registry-seed
# SNAPSHOT_ROOT_PIN_FILE=/private/root-pin.json
# SNAPSHOT_INDEX_KEY_FILE=/private/index-key.json
